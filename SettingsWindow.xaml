<Window x:Class="Cleaner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Cleaner" Width="560" Height="450" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F8FC" FontFamily="Segoe UI">
    <Border Margin="18" Background="White" CornerRadius="16" Padding="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Отмена" Click="CancelButton_Click" Padding="18,9" Margin="0,0,8,0" />
                <Button Content="Сохранить" Click="SaveButton_Click" Padding="18,9" Background="#6756D8" Foreground="White" BorderThickness="0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Настройки очистки" Foreground="#192033" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Настройки применяются только к Temp и кэшам браузеров" Foreground="#7D8497" FontSize="13" Margin="0,6,0,22" />
                <CheckBox x:Name="AgeFilterCheckBox" Content="Не удалять файлы младше 24 часов" FontSize="14" Padding="6" />
                <TextBlock Text="Свежие файлы часто используются работающими приложениями. При включённом режиме они будут пропущены и попадут в отчёт как недоступные для очистки." Foreground="#7D8497" FontSize="12" TextWrapping="Wrap" Margin="6,6,0,20" />
                <TextBlock x:Name="AdminStatusText" Foreground="#3B9A73" FontSize="13" />
                <TextBlock x:Name="DriveStatusText" Foreground="#7D8497" FontSize="13" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

<UserControl x:Class="Cleaner.AppDialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Visibility="Collapsed" Focusable="True">
    <Grid Background="#8C192033">
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="26" Width="560" MaxHeight="420"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" x:Name="MessageText" Foreground="{StaticResource Ink}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" MinWidth="120" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="18,10" MinWidth="140" Click="ConfirmButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

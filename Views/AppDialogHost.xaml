<UserControl x:Class="Cleaner.AppDialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" Visibility="Collapsed" Focusable="True">
    <Grid Background="#CC070A10">
        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource LineHighlight}" BorderThickness="1" CornerRadius="16" Padding="28" Width="540" MaxHeight="430"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TitleText" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" x:Name="MessageText" Foreground="#C8D4E5" FontSize="13.5" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="ConfirmButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

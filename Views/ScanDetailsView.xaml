<UserControl x:Class="Cleaner.ScanDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Найденные данные" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <ListView Grid.Row="1" x:Name="FilesList" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Категория" DisplayMemberBinding="{Binding Category}" Width="185" />
                        <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding Size}" Width="85" />
                        <GridViewColumn Header="Путь" DisplayMemberBinding="{Binding Path}" Width="530" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Button Grid.Row="2" Content="Назад" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="BackButton_Click" />
        </Grid>
    </Border>
</UserControl>

<Window x:Class="Cleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cleaner"
        Title="Cleaner" Width="1180" Height="760" MinWidth="1000" MinHeight="680" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Icon="/Cleaner;component/assets/cleaner-icon.ico" Background="{StaticResource WindowBackground}" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,26">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,42"><Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Purple}"><TextBlock Text="✦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Cleaner" Foreground="{StaticResource Ink}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" /></StackPanel>
                        <TextBlock Text="ОБЗОР" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="18,0,0,10" />
                        <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Click="HomeNavigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="20" Width="28"/><TextBlock Text="Главная" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button x:Name="ProgramsNavButton" Style="{StaticResource NavButton}" Click="ProgramsNavigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="18" Width="28"/><TextBlock Text="Программы" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button x:Name="HistoryNavButton" Style="{StaticResource NavButton}" Click="HistoryNavigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="18" Width="28"/><TextBlock Text="История" VerticalAlignment="Center" /></StackPanel></Button>
                        <TextBlock Text="ПРИЛОЖЕНИЕ" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="18,32,0,10" />
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNavigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="28"/><TextBlock Text="Настройки" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button x:Name="HelpNavButton" Style="{StaticResource NavButton}" Click="HelpNavigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="?" FontSize="18" Width="28"/><TextBlock Text="Помощь" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource PurpleLight}" CornerRadius="12" Padding="14" Margin="0,20,0,0"><StackPanel><TextBlock Text="Ваш компьютер" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><TextBlock Text="Защищён и готов к очистке" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" /><ProgressBar x:Name="FreeSpaceProgress" Value="0" Height="5" Margin="0,13,0,0" Foreground="{StaticResource Purple}" Background="{StaticResource Line}" /></StackPanel></Border>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="42,14,48,14">
                <Grid x:Name="HomeView">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="WelcomeText" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Проверим, всё ли в порядке с вашим компьютером" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,0" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" CornerRadius="21" Background="{StaticResource PurpleLight}"><TextBlock x:Name="UserInitialText" Foreground="{StaticResource Purple}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Состояние системы" Foreground="{StaticResource Muted}" FontSize="13" /><TextBlock x:Name="StatusText" Text="Всё чисто" Foreground="{StaticResource Ink}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="StatusDetails" Text="Проверка ещё не выполнялась" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0" /><ProgressBar x:Name="ScanProgressBar" Height="4" Width="290" HorizontalAlignment="Left" Margin="0,9,0,0" IsIndeterminate="True" Visibility="Collapsed" /><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="ScanButton" Content="Начать проверку" Click="ScanButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" /><Button x:Name="DriveButton" Content="Диски..." Click="DriveButton_Click" Style="{StaticResource NavButton}" Margin="8,0,0,0" /></StackPanel></StackPanel><Grid Grid.Column="1" Margin="12,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Grid.Column="0" Width="145" Height="145"><Canvas x:Name="DiskUsageRing" Width="145" Height="145"><Ellipse Width="145" Height="145" Stroke="{StaticResource Line}" StrokeThickness="12" /></Canvas><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="FreeSpaceText" Text="—" Foreground="{StaticResource Ink}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="свободно" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Grid><StackPanel x:Name="DiskLegendPanel" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid></Grid></Border>
                    <Grid Grid.Row="2" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Temp и кэш пользователя" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="UserTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="UserTempSubtitle" Text="Ожидает проверки" Foreground="#63D6A1" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="Системный Temp" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="WindowsTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="WindowsTempSubtitle" Text="Ожидает проверки" Foreground="#63D6A1" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Корзина" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="RecycleBinValue" Text="—" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="RecycleBinSubtitle" Text="Ожидает проверки" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border></Grid>
                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,11,0"><StackPanel><TextBlock Text="Что можно очистить" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Выберите категории для следующей очистки" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,16" /><CheckBox x:Name="UserTempCheckBox" Content="Временные файлы пользователя" IsChecked="True" Foreground="{StaticResource Ink}" FontSize="14" Padding="0" VerticalContentAlignment="Center" Margin="0,4" /><CheckBox x:Name="WindowsTempCheckBox" Content="Системные временные файлы" IsChecked="False" Foreground="{StaticResource Ink}" FontSize="14" Padding="0" VerticalContentAlignment="Center" Margin="0,4" /><CheckBox x:Name="RecycleBinCheckBox" Content="Содержимое корзины" IsChecked="False" Foreground="{StaticResource Ink}" FontSize="14" Padding="0" VerticalContentAlignment="Center" Margin="0,4" /><Button x:Name="CleanButton" Content="Очистить выбранное" Click="CleanButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" IsEnabled="False" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="11,0,0,0"><StackPanel><TextBlock Text="Последняя активность" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="ActivityText" Text="Проверка ещё не выполнялась" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,18" /><TextBlock x:Name="ActivityResultText" Text="Запустите сканирование" Foreground="#3B9A73" FontSize="13" Margin="0,0,0,12" /><TextBlock x:Name="ActivitySizeText" Text="Данные не удаляются без подтверждения" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" /><Button x:Name="DetailsButton" Content="Показать детали" Click="DetailsButton_Click" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Margin="-18,12,0,0" IsEnabled="False" /></StackPanel></Border></Grid>
                </Grid>
                <ContentControl x:Name="PageHost" Visibility="Collapsed" />
            </Grid>
        </Grid>
        <local:AppDialogHost x:Name="Dialog" />
    </Grid>
</Window>

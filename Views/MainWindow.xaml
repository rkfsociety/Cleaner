<Window x:Class="Cleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cleaner"
        Title="Cleaner" Width="1180" Height="760" MinWidth="1020" MinHeight="690" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Icon="/Cleaner;component/assets/cleaner-icon.ico" Background="{StaticResource WindowBackground}" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="18,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,36">
                            <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource Purple}">
                                <TextBlock Text="✦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Cleaner" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="SidebarVersionText" Text="Windows Utility" Foreground="{StaticResource Muted}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="ОБЗОР" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="14,0,0,8" />
                        <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Click="HomeNavigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" FontSize="18" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="Главная" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProgramsNavButton" Style="{StaticResource NavButton}" Click="ProgramsNavigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤" FontSize="16" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="Программы" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistoryNavButton" Style="{StaticResource NavButton}" Click="HistoryNavigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="16" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="История" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ПРИЛОЖЕНИЕ" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="14,26,0,8" />
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNavigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="16" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="Настройки" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HelpNavButton" Style="{StaticResource NavButton}" Click="HelpNavigation_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="?" FontSize="16" Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="Помощь" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#1D2234" BorderBrush="#2D354F" BorderThickness="1" CornerRadius="14" Padding="15" VerticalAlignment="Bottom">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Ваш компьютер" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="#213830" CornerRadius="6" Padding="7,2" HorizontalAlignment="Right">
                                    <TextBlock Text="Активен" Foreground="#63D6A1" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="SidebarDriveSubtext" Text="Защищён и готов к очистке" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="FreeSpaceProgress" Value="0" Height="6" Margin="0,12,0,0" Foreground="{StaticResource Purple}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="36,20,38,20">
                <Grid x:Name="HomeView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WelcomeText" Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="Проверим состояние системы и освободим место от временного мусора" Foreground="{StaticResource Muted}" FontSize="13.5" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="42" Height="42" CornerRadius="21" Background="{StaticResource PurpleLight}" BorderBrush="#39335E" BorderThickness="1">
                            <TextBlock x:Name="UserInitialText" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="425" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="СОСТОЯНИЕ СИСТЕМЫ" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusText" Text="Всё чисто" Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0" />
                                <TextBlock x:Name="StatusDetails" Text="Проверка ещё не выполнялась" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <ProgressBar x:Name="ScanProgressBar" Height="5" Width="300" HorizontalAlignment="Left" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="ScanButton" Content="Начать проверку" Click="ScanButton_Click" Style="{StaticResource PrimaryButton}" />
                                    <Button x:Name="DriveButton" Content="Диски..." Click="DriveButton_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#141A26" BorderBrush="#242D3F" BorderThickness="1" CornerRadius="14" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="145" Height="145" VerticalAlignment="Center">
                                        <Canvas x:Name="DiskUsageRing" Width="145" Height="145">
                                            <Ellipse Width="145" Height="145" Stroke="{StaticResource Line}" StrokeThickness="12" />
                                        </Canvas>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="FreeSpaceText" Text="—" Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="свободно" Foreground="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="DiskLegendPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,7,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Temp и кэш пользователя" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#45B79C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="UserTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock x:Name="UserTempSubtitle" Text="Ожидает проверки" Foreground="#63D6A1" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,15" Margin="7,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Системный Temp и обновления" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#8B7CFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="WindowsTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock x:Name="WindowsTempSubtitle" Text="Ожидает проверки" Foreground="#63D6A1" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,15" Margin="7,0,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Корзина" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#EF8E5B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="RecycleBinValue" Text="—" Foreground="{StaticResource Ink}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock x:Name="RecycleBinSubtitle" Text="Ожидает проверки" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,7,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Что можно очистить" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Выберите категории для следующей очистки" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,14" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <CheckBox x:Name="UserTempCheckBox" Content="Временные файлы, дампы и кэши браузеров" IsChecked="True" Margin="0,5" />
                                    <CheckBox x:Name="WindowsTempCheckBox" Content="Системные временные файлы и кэш обновлений" IsChecked="False" Margin="0,5" />
                                    <CheckBox x:Name="RecycleBinCheckBox" Content="Содержимое корзины выбранных дисков" IsChecked="False" Margin="0,5" />
                                </StackPanel>
                                <Button Grid.Row="2" x:Name="CleanButton" Content="Очистить выбранное" Click="CleanButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,18" Margin="7,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Последняя активность" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ActivityText" Text="Проверка ещё не выполнялась" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,12" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActivityResultText" Text="Запустите сканирование" Foreground="#63D6A1" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ActivitySizeText" Text="Данные не удаляются без подтверждения" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Row="2" x:Name="DetailsButton" Content="Показать детали" Click="DetailsButton_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ContentControl x:Name="PageHost" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <local:AppDialogHost x:Name="Dialog" />
    </Grid>
</Window>

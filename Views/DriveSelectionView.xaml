<UserControl x:Class="Cleaner.DriveSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Выбор дисков" Style="{StaticResource PageTitle}" />
            <TextBlock Text="По умолчанию выбран системный диск. Проверяются только известные Temp, кэши браузеров и корзина — произвольные папки диска не сканируются." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Выбрать все" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SelectAllButton_Click" />
                <Button Content="Снять все" Style="{StaticResource SecondaryButton}" Click="ClearAllButton_Click" />
            </StackPanel>
            <StackPanel x:Name="DrivePanel" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Назад" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BackButton_Click" />
                <Button Content="Применить" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="18,10" Click="ApplyButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

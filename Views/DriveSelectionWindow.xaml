<Window x:Class="Cleaner.DriveSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор дисков" Width="460" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F8FC" FontFamily="Segoe UI">
    <Border Margin="18" Background="White" CornerRadius="16" Padding="24">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Отмена" Click="CancelButton_Click" Padding="18,9" Margin="0,0,8,0" />
                <Button Content="Применить" Click="ApplyButton_Click" Padding="18,9" Background="#6756D8" Foreground="White" BorderThickness="0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Выбор дисков" Foreground="#192033" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="По умолчанию выбран системный диск. Проверяются только известные Temp, кэши браузеров и корзина — произвольные папки диска не сканируются." Foreground="#7D8497" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,10" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Выбрать все" Click="SelectAllButton_Click" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="Снять все" Click="ClearAllButton_Click" Padding="12,6" />
                </StackPanel>
                <StackPanel x:Name="DrivePanel" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

<Window x:Class="Cleaner.ProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установленные программы" Width="1020" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F8FC" FontFamily="Segoe UI">
    <Border Margin="18" Background="White" CornerRadius="16" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Установленные программы" Foreground="#192033" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Text="Читаем список программ..." Foreground="#7D8497" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,16,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Поиск" Foreground="#7D8497" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged" />
                </Grid>
                <ComboBox x:Name="SortBox" Grid.Column="1" Width="230" Height="30" Margin="10,0,0,0" VerticalContentAlignment="Center" SelectionChanged="Filters_Changed">
                    <ComboBoxItem Content="Сначала давно не использовались" IsSelected="True" />
                    <ComboBoxItem Content="Сначала недавно использовались" />
                    <ComboBoxItem Content="Сначала самые большие" />
                    <ComboBoxItem Content="Сначала недавно установленные" />
                    <ComboBoxItem Content="По названию" />
                </ComboBox>
                <ComboBox x:Name="UnusedBox" Grid.Column="2" Width="190" Height="30" Margin="10,0,0,0" VerticalContentAlignment="Center" SelectionChanged="Filters_Changed">
                    <ComboBoxItem Content="Все программы" IsSelected="True" />
                    <ComboBoxItem Content="Простой от 30 дней" />
                    <ComboBoxItem Content="Простой от 90 дней" />
                    <ComboBoxItem Content="Простой от 180 дней" />
                    <ComboBoxItem Content="Простой от 365 дней" />
                </ComboBox>
                <Button x:Name="RefreshButton" Grid.Column="3" Content="Обновить" Width="100" Height="30" Margin="10,0,0,0" Click="RefreshButton_Click" />
            </Grid>
            <ListView Grid.Row="2" x:Name="ProgramsList" BorderBrush="#E8EAF1" BorderThickness="1" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Программа" DisplayMemberBinding="{Binding Name}" Width="290" />
                        <GridViewColumn Header="Издатель" DisplayMemberBinding="{Binding Publisher}" Width="170" />
                        <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding Size}" Width="90" />
                        <GridViewColumn Header="Установлена" DisplayMemberBinding="{Binding Installed}" Width="105" />
                        <GridViewColumn Header="Последний запуск" DisplayMemberBinding="{Binding LastUsed}" Width="140" />
                        <GridViewColumn Header="Простой" DisplayMemberBinding="{Binding Idle}" Width="100" />
                        <GridViewColumn Header="Источник" DisplayMemberBinding="{Binding Source}" Width="120" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="#7D8497" FontSize="12" TextWrapping="Wrap" Width="600" HorizontalAlignment="Left"
                           Text="Cleaner ничего не удаляет из этого списка. Чтобы удалить программу, откройте стандартное окно Windows." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Открыть удаление программ Windows" Padding="14,8" Click="OpenWindowsAppsButton_Click" />
                    <Button Content="Закрыть" IsDefault="True" Width="110" Margin="10,0,0,0" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

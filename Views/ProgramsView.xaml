<UserControl x:Class="Cleaner.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Установленные программы" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Text="Читаем список программ..." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,14,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Поиск" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged" />
                </Grid>
                <ComboBox x:Name="SortBox" Grid.Column="1" Width="215" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectionChanged="Filters_Changed">
                    <ComboBoxItem Content="Сначала давно не использовались" IsSelected="True" />
                    <ComboBoxItem Content="Сначала недавно использовались" />
                    <ComboBoxItem Content="Сначала самые большие" />
                    <ComboBoxItem Content="Сначала недавно установленные" />
                    <ComboBoxItem Content="По названию" />
                </ComboBox>
                <ComboBox x:Name="UnusedBox" Grid.Column="2" Width="165" Height="30" Margin="8,0,0,0" VerticalContentAlignment="Center" SelectionChanged="Filters_Changed">
                    <ComboBoxItem Content="Все программы" IsSelected="True" />
                    <ComboBoxItem Content="Простой от 30 дней" />
                    <ComboBoxItem Content="Простой от 90 дней" />
                    <ComboBoxItem Content="Простой от 180 дней" />
                    <ComboBoxItem Content="Простой от 365 дней" />
                </ComboBox>
                <Button x:Name="RefreshButton" Grid.Column="3" Content="Обновить" Style="{StaticResource SecondaryButton}" Width="92" Height="30" Padding="0" Margin="8,0,0,0" Click="RefreshButton_Click" />
            </Grid>
            <ListView Grid.Row="2" x:Name="ProgramsList" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                      SelectionChanged="ProgramsList_SelectionChanged" MouseDoubleClick="ProgramsList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Программа" DisplayMemberBinding="{Binding Name}" Width="212" />
                        <GridViewColumn Header="Издатель" DisplayMemberBinding="{Binding Publisher}" Width="122" />
                        <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding Size}" Width="70" />
                        <GridViewColumn Header="Установлена" DisplayMemberBinding="{Binding Installed}" Width="88" />
                        <GridViewColumn Header="Последний запуск" DisplayMemberBinding="{Binding LastUsed}" Width="110" />
                        <GridViewColumn Header="Простой" DisplayMemberBinding="{Binding Idle}" Width="68" />
                        <GridViewColumn Header="Источник" DisplayMemberBinding="{Binding Source}" Width="112" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Width="410" HorizontalAlignment="Left"
                           Text="Удаление выполняет собственный деинсталлятор программы: он запросит подтверждение и может потребовать прав администратора." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UninstallButton" Content="Удалить программу" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="UninstallButton_Click" />
                    <Button Content="Окно Windows" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OpenWindowsAppsButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

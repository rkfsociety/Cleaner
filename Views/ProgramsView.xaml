<UserControl x:Class="Cleaner.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="Установленные программы" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SummaryText" Text="Читаем список программ..." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,14,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Поиск" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="8,0" TextChanged="SearchBox_TextChanged" />
                </Grid>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryButton}" Width="92" Height="30" Padding="0" Margin="8,0,0,0" Click="RefreshButton_Click" />
            </Grid>
            <ListView Grid.Row="2" x:Name="ProgramsList" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                      SelectionChanged="ProgramsList_SelectionChanged" MouseDoubleClick="ProgramsList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Width="212"><GridViewColumnHeader x:Name="NameHeader" Content="Программа" Tag="Name" Click="ProgramColumnHeader_Click" /></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Publisher}" Width="122"><GridViewColumnHeader x:Name="PublisherHeader" Content="Издатель" Tag="Name" Click="ProgramColumnHeader_Click" /></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Size}" Width="70"><GridViewColumnHeader x:Name="SizeHeader" Content="Размер" Tag="LargestFirst" Click="ProgramColumnHeader_Click" /></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Installed}" Width="88"><GridViewColumnHeader x:Name="InstalledHeader" Content="Установлена" Tag="NewestInstall" Click="ProgramColumnHeader_Click" /></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding LastUsed}" Width="110"><GridViewColumnHeader x:Name="LastUsedHeader" Content="Последний запуск" Tag="LeastRecentlyUsed" Click="ProgramColumnHeader_Click" /></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Idle}" Width="68"><GridViewColumnHeader x:Name="IdleHeader" Content="Простой" Tag="LeastRecentlyUsed" Click="ProgramColumnHeader_Click" /></GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Source}" Width="112"><GridViewColumnHeader x:Name="SourceHeader" Content="Источник" Tag="Name" Click="ProgramColumnHeader_Click" /></GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Width="410" HorizontalAlignment="Left"
                           Text="Удаление выполняет собственный деинсталлятор программы: он запросит подтверждение и может потребовать прав администратора." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UninstallButton" Content="Удалить программу" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="UninstallButton_Click" />
                    <Button Content="Окно Windows" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OpenWindowsAppsButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

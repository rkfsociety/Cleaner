<UserControl x:Class="Cleaner.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Настройки очистки" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Настройки применяются только к Temp и кэшам браузеров" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,18" />
            <CheckBox x:Name="AgeFilterCheckBox" Content="Не удалять файлы младше 24 часов" FontSize="14" Padding="0" VerticalContentAlignment="Center" Margin="0,0,0,2" Click="AgeFilterCheckBox_Click" />
            <TextBlock Text="Свежие файлы часто используются работающими приложениями. При включённом режиме они будут пропущены и попадут в отчёт как недоступные для очистки." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="6,6,0,16" />
            <TextBlock x:Name="AdminStatusText" Foreground="#3B9A73" FontSize="13" />
            <TextBlock x:Name="DriveStatusText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
            <Border Background="{StaticResource InputBackground}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Постоянный белый список исключений" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Добавить папку" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Click="AddExclusionFolderButton_Click" />
                            <Button Content="Добавить файл" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Margin="6,0,0,0" Click="AddExclusionFileButton_Click" />
                            <Button x:Name="RemoveExclusionButton" Content="Удалить" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Margin="6,0,0,0" IsEnabled="False" Click="RemoveExclusionButton_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Файлы и папки из этого списка автоматически исключаются при проверке и очистке." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8" />
                    <ListBox x:Name="ExclusionsList" Height="105" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" SelectionChanged="ExclusionsList_SelectionChanged" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource InputBackground}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Обновления DiskPulse" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateVersionText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" />
                    <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CheckUpdatesButton" Content="Проверить обновления" Style="{StaticResource SecondaryButton}" Click="CheckUpdatesButton_Click" />
                        <Button x:Name="InstallCurrentButton" Content="Установить в профиль" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="14,9" Margin="10,0,0,0" Click="InstallCurrentButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Выбрать диски" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="DrivesButton_Click" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="18,10" Click="SaveButton_Click" />
            </StackPanel>
            <TextBlock x:Name="SaveStatusText" Foreground="#3B9A73" FontSize="13" HorizontalAlignment="Right" Margin="0,8,0,0" />
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

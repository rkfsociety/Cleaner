<UserControl x:Class="Cleaner.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Настройки очистки" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Настройки применяются только к Temp и кэшам браузеров" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,22" />
            <CheckBox x:Name="AgeFilterCheckBox" Content="Не удалять файлы младше 24 часов" FontSize="14" Padding="0" VerticalContentAlignment="Center" Margin="0,0,0,2" />
            <TextBlock Text="Свежие файлы часто используются работающими приложениями. При включённом режиме они будут пропущены и попадут в отчёт как недоступные для очистки." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="6,6,0,20" />
            <TextBlock x:Name="AdminStatusText" Foreground="#3B9A73" FontSize="13" />
            <TextBlock x:Name="DriveStatusText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Выбрать диски" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="DrivesButton_Click" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="18,10" Click="SaveButton_Click" />
            </StackPanel>
            <TextBlock x:Name="SaveStatusText" Foreground="#3B9A73" FontSize="13" HorizontalAlignment="Right" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>

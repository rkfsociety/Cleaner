<UserControl x:Class="Cleaner.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Как пользоваться Cleaner" Style="{StaticResource PageTitle}" />
            <TextBlock Foreground="{StaticResource Ink}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="1. На главной нажмите «Начать проверку».&#10;2. При необходимости выберите диски.&#10;3. Отметьте категории очистки.&#10;4. Откройте детали и нажмите «Очистить выбранное».&#10;5. Подтвердите удаление." />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0"
                       Text="Результат проверки действует пять минут. Занятые, недоступные и связанные с другими местами файлы пропускаются. Для системного Temp Cleaner открывает отдельную повышенную сессию, в которой пользовательские данные и корзина отключены." />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Раздел «Программы» показывает установленное ПО и давность его использования: сначала идут те, что дольше всего не запускались. Удаление там запускает штатный деинсталлятор программы — подтверждение и права администратора запрашивает он сам, Cleaner файлы не удаляет." />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Настройки и история хранятся в папке %LOCALAPPDATA%\Cleaner. Там же ведётся журнал ошибок app.log." />
        </StackPanel>
    </Border>
</UserControl>

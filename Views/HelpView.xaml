<UserControl x:Class="Cleaner.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Border Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Как пользоваться DiskPulse" Style="{StaticResource PageTitle}" />
            <TextBlock Foreground="{StaticResource Ink}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="1. На главной нажмите «Начать проверку».&#10;2. При необходимости выберите диски.&#10;3. Откройте «Показать детали», чтобы просмотреть файлы, отфильтровать их или снять галочки с тех, что нужно оставить.&#10;4. Отметьте категории очистки и нажмите «Очистить выбранное».&#10;5. Подтвердите удаление." />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,0"
                       Text="Результат проверки действует пять минут. Занятые, недоступные и связанные со ссылками (junction/symlink) файлы безопасно пропускаются. Для системного Temp и кэша обновлений Windows DiskPulse открывает повышенную сессию с правами администратора, в которой доступны все категории очистки." />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Раздел «Программы» показывает установленное ПО и давность его использования с фильтрацией по времени простоя. Удаление запускает штатный деинсталлятор производителя, а после его завершения DiskPulse проверяет оставшиеся файлы и записи реестра и предлагает удалить их с отдельного подтверждения." />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Настройки и история хранятся в папке %LOCALAPPDATA%\Cleaner. Там же ведётся журнал действий и ошибок app.log." />
        </StackPanel>
    </Border>
</UserControl>

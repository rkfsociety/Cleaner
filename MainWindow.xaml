<Window x:Class="Cleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleaner" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F7F8FC" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#192033" />
        <SolidColorBrush x:Key="Muted" Color="#7D8497" />
        <SolidColorBrush x:Key="Purple" Color="#6756D8" />
        <SolidColorBrush x:Key="PurpleLight" Color="#EEEAFE" />
        <SolidColorBrush x:Key="Line" Color="#E8EAF1" />
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8D94A8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0EEFC" /><Setter Property="Foreground" Value="{StaticResource Purple}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="22" /></Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Purple}" /><Setter Property="Foreground" Value="White" /><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="24,14" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5747C7" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,26">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,42"><Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Purple}"><TextBlock Text="✦" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Cleaner" Foreground="{StaticResource Ink}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" /></StackPanel>
                    <TextBlock Text="ОБЗОР" Foreground="#B0B5C4" FontSize="11" FontWeight="SemiBold" Margin="18,0,0,10" />
                    <Button Style="{StaticResource NavButton}" Background="{StaticResource PurpleLight}" Foreground="{StaticResource Purple}"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="20" Width="28"/><TextBlock Text="Главная" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="◌" FontSize="20" Width="28"/><TextBlock Text="Очистка" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="18" Width="28"/><TextBlock Text="История" VerticalAlignment="Center" /></StackPanel></Button>
                    <TextBlock Text="ПРИЛОЖЕНИЕ" Foreground="#B0B5C4" FontSize="11" FontWeight="SemiBold" Margin="18,32,0,10" />
                    <Button Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="28"/><TextBlock Text="Настройки" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="?" FontSize="18" Width="28"/><TextBlock Text="Помощь" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#F5F3FE" CornerRadius="12" Padding="14" Margin="0,20,0,0"><StackPanel><TextBlock Text="Ваш компьютер" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><TextBlock Text="Защищён и готов к очистке" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" /><ProgressBar Value="68" Height="5" Margin="0,13,0,0" Foreground="{StaticResource Purple}" Background="#DDD9F7" /></StackPanel></Border>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="42,34,48,42">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,30"><StackPanel><TextBlock x:Name="WelcomeText" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Проверим, всё ли в порядке с вашим компьютером" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,7,0,0" /></StackPanel><Border HorizontalAlignment="Right" Width="42" Height="42" CornerRadius="21" Background="#E4E1FA"><TextBlock x:Name="UserInitialText" Foreground="{StaticResource Purple}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="30" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Состояние системы" Foreground="{StaticResource Muted}" FontSize="13" /><TextBlock x:Name="StatusText" Text="Всё чисто" Foreground="{StaticResource Ink}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="StatusDetails" Text="Последняя проверка сегодня в 18:42" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0" /><Button x:Name="ScanButton" Content="Начать проверку" Click="ScanButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" /></StackPanel><Grid Grid.Column="1" Width="158" Height="158" Margin="30,0,10,0"><Ellipse Stroke="#E5E1FC" StrokeThickness="13" /><Ellipse Stroke="{StaticResource Purple}" StrokeThickness="13" StrokeDashArray="5 2" /><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="68%" Foreground="{StaticResource Ink}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="свободно" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Grid></Grid></Border>
                <Grid Grid.Row="2" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Папка пользователя Temp" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="UserTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="UserTempSubtitle" Text="Ожидает проверки" Foreground="#3B9A73" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="Системный Temp" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="WindowsTempValue" Text="—" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="WindowsTempSubtitle" Text="Ожидает проверки" Foreground="#3B9A73" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Корзина" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Text="Скоро" Foreground="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Безопасный режим" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border></Grid>
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,11,0"><StackPanel><TextBlock Text="Что можно очистить" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Выберите категории для следующей очистки" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,16" /><CheckBox x:Name="UserTempCheckBox" Content="Временные файлы пользователя" IsChecked="True" Foreground="{StaticResource Ink}" FontSize="14" Padding="6" Margin="0,4" /><CheckBox x:Name="WindowsTempCheckBox" Content="Системные временные файлы" IsChecked="False" Foreground="{StaticResource Ink}" FontSize="14" Padding="6" Margin="0,4" /><CheckBox Content="Содержимое корзины" IsEnabled="False" Foreground="{StaticResource Muted}" FontSize="14" Padding="6" Margin="0,4" /><Button x:Name="CleanButton" Content="Очистить выбранное" Click="CleanButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" IsEnabled="False" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="11,0,0,0"><StackPanel><TextBlock Text="Последняя активность" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="ActivityText" Text="Проверка ещё не выполнялась" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,18" /><TextBlock x:Name="ActivityResultText" Text="Запустите сканирование" Foreground="#3B9A73" FontSize="13" Margin="0,0,0,12" /><TextBlock x:Name="ActivitySizeText" Text="Данные не удаляются без подтверждения" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" /></StackPanel></Border></Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
